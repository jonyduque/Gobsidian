{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File scripts/pre_commit_docs.ps1",
            "if": "Bash(git commit*)",
            "timeout": 20,
            "statusMessage": "Conferindo se a documentacao acompanhou o codigo..."
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File scripts/pre_commit_docs.ps1",
            "if": "PowerShell(git commit*)",
            "timeout": 20,
            "statusMessage": "Conferindo se a documentacao acompanhou o codigo..."
          }
        ]
      }
    ]
  }
}

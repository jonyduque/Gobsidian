 func Canonicalize(root, abs string) (CanonicalPath, error) {
 	rel, err := filepath.Rel(root, abs)
 	if err != nil {
 		return "", fmt.Errorf("%w: %q", ErrOutsideVault, abs)
 	}
 
 	slashed := filepath.ToSlash(rel)
 	if slashed == ".." || strings.HasPrefix(slashed, "../") {
 		return "", fmt.Errorf("%w: %q", ErrOutsideVault, abs)
 	}

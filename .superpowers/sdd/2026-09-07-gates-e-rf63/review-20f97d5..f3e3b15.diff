+    foreach ($m in [regex]::Matches($linha, $reM)) {
+        $texto = @($m.Groups[1].Value, $m.Groups[2].Value, $m.Groups[3].Value) | Where-Object { $_ } | Select-Object -First 1
+        if ($texto) { $partes.Add($texto) }
+    }
+    $reF = '(?:-F|--file)(?:=|\s+)(?:"([^"]*)"|''([^'']*)''|(\S+))'
+    foreach ($m in [regex]::Matches($linha, $reF)) {

 # suite inteira tem dezenas de milhares de linhas; so o rabo aparece, e so
 # quando a etapa reprova.
 $LogTestes = Join-Path ([System.IO.Path]::GetTempPath()) "gobsidian-verify-testes.txt"
 
 Invoke-Step "go test -race" {

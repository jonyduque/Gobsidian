+
+// observe atualiza o estado com os contadores desta entrada. scanVault so
+// chama isto para notas (ja filtrou anexos antes).
+func (p *platformScanState) observe(e vault.Entry) {
+	if e.CloudOnly {
+		p.cloudOnlyCount++
+	}
+
+	if p.seen == nil {

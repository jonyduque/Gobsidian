+	if err != nil {
+		t.Fatal(err)
+	}
+	achou := map[string]bool{}
+	for _, r := range res.Results {
+		achou[r.Path] = true
+	}
+	if len(res.Results) != 2 || !achou["d.md"] || !achou["e.md"] {
+		t.Fatalf("tags=[ação]: %+v, quero d.md e e.md — a mesma tag em NFD e em NFC", res.Results)
+	}
+}

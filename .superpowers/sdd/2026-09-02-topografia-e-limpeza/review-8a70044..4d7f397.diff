+	if string(got) != "antes" {
+		t.Fatalf("alvo mudou para %q", got)
+	}
+
+	restos, _ := filepath.Glob(filepath.Join(filepath.Dir(alvo), vault.TempFilePrefix+"*"))
+	if len(restos) != 0 {
+		t.Fatalf("temporario ficou para tras: %v", restos)
+	}

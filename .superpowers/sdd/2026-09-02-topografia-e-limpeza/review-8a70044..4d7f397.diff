+		// Escreve antes de falhar: o caso interessante e o temporario ja com
+		// bytes dentro, nao o vazio.
+		if _, wErr := f.Write([]byte("metade do cache")); wErr != nil {
+			t.Errorf("escrevendo no temporario: %v", wErr)
+		}
+		return quero
+	})

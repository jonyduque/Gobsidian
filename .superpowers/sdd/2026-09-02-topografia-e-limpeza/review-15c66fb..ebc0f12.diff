 	_, emitted, reason := filter(evt, root, log)
 	if emitted {
 		t.Errorf("emitted = true, want false para evento fora do vault")
 	}
 	if reason != DropOutsideVault {
 		t.Errorf("reason = %q, want %q", reason, DropOutsideVault)
 	}

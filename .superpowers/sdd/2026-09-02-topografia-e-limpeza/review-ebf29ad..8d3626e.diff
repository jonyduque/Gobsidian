+		t.Fatal(err)
+	}
+	if !cfg.LogLevelExplicito || cfg.LogLevel != slog.LevelWarn {
+		t.Fatalf("env dada: Explicito=%v LogLevel=%v", cfg.LogLevelExplicito, cfg.LogLevel)
+	}
+}

+	}
+
+	visto := map[vault.CanonicalPath]int{}
+	for _, p := range nonRenames {
+		visto[p]++
+	}
+	if len(nonRenames) != 3 {
+		t.Fatalf("nonRenames = %v (len %d), quer 3 entradas distintas", nonRenames, len(nonRenames))
+	}
+	for p, n := range visto {
+		if n != 1 {
+			t.Errorf("%s aparece %d vezes em nonRenames", p, n)
+		}
+	}
+}

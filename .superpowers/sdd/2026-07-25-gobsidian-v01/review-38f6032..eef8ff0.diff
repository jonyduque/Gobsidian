+	if pos1 == -1 || posAnexo == -1 || posCap2 == -1 {
+		t.Fatalf("trecho ausente no resultado:\n%s", s)
+	}
+	if pos1 >= posAnexo || posAnexo >= posCap2 {
+		t.Errorf("ordem incorreta dos trechos: pos1=%d, posAnexo=%d, posCap2=%d:\n%s", pos1, posAnexo, posCap2, s)
+	}

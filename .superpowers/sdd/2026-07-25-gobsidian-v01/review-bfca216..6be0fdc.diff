++			wantKind: parser.LinkEmbed,
++			wantText: "![alt](img.png)",
++		},
++		{
++			name:     "aninhado ambiguo",
++			input:    "[[[a]] b](d.md)",
++			wantKind: parser.LinkMarkdown,
++			wantText: "[[[a]] b](d.md)",
++		},
++		{
++			name:     "parenteses no destino",
++			input:    "[x](a(b).md)",
++			wantKind: parser.LinkMarkdown,
++			wantText: "[x](a(b).md)",
++		},
++		{
++			name:     "com titulo",
++			input:    `[x](a.md "t")`,
++			wantKind: parser.LinkMarkdown,
++			wantText: `[x](a.md "t")`,
++		},
++		{
++			name:     "com BOM",
++			input:    "\xef\xbb\xbf# Topo\n[texto](destino.md)\n",
++			wantKind: parser.LinkMarkdown,
++			wantText: "[texto](destino.md)",
++		},
++	}

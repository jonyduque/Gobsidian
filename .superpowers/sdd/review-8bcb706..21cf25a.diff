+	if got != "uma citacao ^cite1" {
+		t.Errorf("bloco = %q, quer %q", got, "uma citacao ^cite1")
+	}
+}
+
+// TestBlockIDMultiplePerParagraph confirma que dois marcadores na mesma nota

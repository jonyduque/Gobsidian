+func TestBlockIDMultiplePerParagraph(t *testing.T) {
+	src := "primeira linha ^um\nsegunda linha ^dois\n"
+
+	note, err := parser.Parse([]byte(src))
+	if err != nil {
+		t.Fatalf("Parse: %v", err)

 func tagsFromFrontmatter(fm map[string]any) []string {
 	var out []string
 	for _, key := range []string{"tags", "tag"} {
 		for _, v := range stringsFromFrontmatterValue(fm[key]) {
 			out = append(out, strings.TrimPrefix(v, "#"))
 		}
 	}

 func defaultCacheDir(vaultPath string) string {
 	sum := xxhash.Sum64String(strings.ToLower(vaultPath))
 	name := strconv.FormatUint(sum, 16)
 
 	base, err := os.UserCacheDir()
 	if err != nil {
 		base = os.TempDir()
 	}
